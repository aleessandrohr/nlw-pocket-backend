{
	"name": "nlw-pocket-backend",
	"version": "0.1.0",
	"main": "index.js",
	"scripts": {
		"dev": "tsx --env-file .env --watch src/http/server.ts | pino-pretty",
		"build": "tsup src",
		"build:bun": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile build/server src/http/server.ts",
		"start": "node --env-file=.env ./dist/http/server.js | pino-pretty",
		"start:bun": "./build/server | pino-pretty",
		"docker:start": "docker compose up -d",
		"docker:stop": "docker compose stop",
		"db:generate": "npx drizzle-kit generate",
		"db:migrate": "npx drizzle-kit migrate",
		"db:studio": "npx drizzle-kit studio",
		"cleanup:demo": "tsx --env-file .env src/db/cleanup-demo.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.20.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.2",
		"@fastify/cors": "^11.3.0",
		"@fastify/csrf-protection": "^7.1.0",
		"@fastify/jwt": "^10.2.2",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"@paralleldrive/cuid2": "^2.3.1",
		"bcryptjs": "^3.0.3",
		"crypto": "^1.0.1",
		"dayjs": "^1.11.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.1",
		"fastify-type-provider-zod": "^5.1.0",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	}
}
